PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET
# Must match the admin email configured in Supabase v13_admin.sql
ADMIN_EMAIL=your-admin-email@example.com

# Cloudflare R2 private dataset storage
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET_NAME=verdant-gis-datasets
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com

# Experiential Labs / Verdant AI
# Keep the API key server-side only; never prefix the value with "Bearer".
EXPLABS_API_KEY=YOUR_EXPERIENTIAL_LABS_API_KEY
EXPLABS_MODEL=gpt-6-astra
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
